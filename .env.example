# Development only. Generate your own values before using a shared or deployed environment.
COMPOSE_PROJECT_NAME=world-heritage-practice
FRONTEND_PORT=3110
API_PORT=3111
DB_PORT=55440
POSTGRES_USER=world_heritage
POSTGRES_PASSWORD=change-this-local-development-password
DB_NAME=world_heritage_development
# Empty uses the same Nuxt origin for /api/v1. API_PORT remains a compatibility alias.
NUXT_PUBLIC_API_BASE=
FRONTEND_URL=http://localhost:3110
CORS_ORIGINS=http://localhost:3110,http://127.0.0.1:3110
BETTER_AUTH_SECRET=replace-with-a-random-secret-at-least-64-characters-long-before-deployment
BETTER_AUTH_URL=http://localhost:3110
# Optional paid mode: config/exam.json payments.enabled must also be true.
PAID_MEMBERSHIP_ENABLED=false
STRIPE_LIVEMODE=false
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_ID=
# Optional dedicated Customer Portal configuration for this service.
STRIPE_PORTAL_CONFIGURATION_ID=
# Optional direct URL for migrations; omit when DATABASE_URL is already direct.
DATABASE_URL_UNPOOLED=
# Set both on Fly when using Netlify signed API proxy redirects.
# Store the same proxy secret in Netlify with Runtime scope; never expose it publicly.
NETLIFY_PROXY_SECRET=
NETLIFY_SITE_ID=
NUXT_PUBLIC_SELLER_NAME=
NUXT_PUBLIC_SELLER_REPRESENTATIVE=
NUXT_PUBLIC_SELLER_EMAIL=
NUXT_PUBLIC_SELLER_ADDRESS=
NUXT_PUBLIC_SELLER_PHONE=
SELLER_CONTACT_DISCLOSURE_MODE=public

# Optional password-reset mail. Set independently for each deployed site.
PASSWORD_RESET_ENABLED=false
PASSWORD_RESET_GAS_URL=
PASSWORD_RESET_GAS_SECRET=
