{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "type": "object",
  "properties": {
    "schema_version": {
      "type": "number",
      "const": 1
    },
    "grades": {
      "default": [
        {
          "code": "2",
          "label": "2級",
          "questions_per_exam": 60
        },
        {
          "code": "pre1",
          "label": "準1級",
          "questions_per_exam": 60
        },
        {
          "code": "1",
          "label": "1級",
          "questions_per_exam": 90
        }
      ],
      "minItems": 3,
      "maxItems": 3,
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "code": {
            "type": "string",
            "enum": [
              "1",
              "2",
              "pre1"
            ]
          },
          "label": {
            "type": "string",
            "pattern": "\\S"
          },
          "questions_per_exam": {
            "type": "integer",
            "minimum": 1,
            "maximum": 10000
          }
        },
        "required": [
          "code",
          "label",
          "questions_per_exam"
        ]
      }
    },
    "site": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]{0,39}$"
        },
        "name": {
          "type": "string",
          "pattern": "\\S"
        },
        "short_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "exam_name": {
          "type": "string",
          "pattern": "\\S"
        },
        "description": {
          "type": "string",
          "pattern": "\\S"
        },
        "tagline": {
          "type": "string",
          "pattern": "\\S"
        },
        "logo_path": {
          "type": "string",
          "pattern": "^\\/(?!\\/)(?!\\.\\.(?:\\/|$))(?!.*\\/\\.\\.(?:\\/|$))[A-Za-z0-9_./-]+$"
        },
        "primary_color": {
          "type": "string",
          "pattern": "^#[0-9a-fA-F]{6}$"
        },
        "contact_email": {
          "type": "string",
          "pattern": "^(?:|[^\\s@]+@[^\\s@]+\\.[^\\s@]+)$"
        },
        "notice": {
          "default": "",
          "type": "string"
        },
        "overview": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "title": {
                "type": "string",
                "pattern": "\\S"
              },
              "body": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "title",
              "body"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "id",
        "name",
        "short_name",
        "exam_name",
        "description",
        "tagline",
        "logo_path",
        "primary_color",
        "contact_email",
        "overview"
      ],
      "additionalProperties": {}
    },
    "exam": {
      "type": "object",
      "properties": {
        "set_count": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "questions_per_exam": {
          "type": "integer",
          "minimum": 1,
          "maximum": 10000
        },
        "choice_labels": {
          "minItems": 2,
          "maxItems": 10,
          "type": "array",
          "items": {
            "type": "string",
            "maxLength": 10,
            "pattern": "\\S"
          }
        }
      },
      "required": [
        "set_count",
        "questions_per_exam",
        "choice_labels"
      ],
      "additionalProperties": {}
    },
    "categories": {
      "type": "object",
      "properties": {
        "major": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              "label": {
                "type": "string",
                "pattern": "\\S"
              }
            },
            "required": [
              "value",
              "label"
            ],
            "additionalProperties": {}
          }
        },
        "minor": {
          "minItems": 1,
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              },
              "label": {
                "type": "string",
                "pattern": "\\S"
              },
              "major_category_value": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9_]{0,49}$"
              }
            },
            "required": [
              "value",
              "label",
              "major_category_value"
            ],
            "additionalProperties": {}
          }
        }
      },
      "required": [
        "major",
        "minor"
      ],
      "additionalProperties": {}
    },
    "payments": {
      "type": "object",
      "properties": {
        "billing_interval": {
          "default": "month",
          "type": "string",
          "const": "month"
        },
        "enabled": {
          "type": "boolean"
        },
        "free_exam_count": {
          "type": "integer",
          "minimum": 0,
          "maximum": 9007199254740991
        },
        "amount": {
          "type": "integer",
          "minimum": 1,
          "maximum": 9007199254740991
        },
        "currency": {
          "type": "string",
          "pattern": "^jpy$"
        }
      },
      "required": [
        "enabled",
        "free_exam_count",
        "amount",
        "currency"
      ],
      "additionalProperties": {}
    }
  },
  "required": [
    "schema_version",
    "site",
    "exam",
    "categories",
    "payments"
  ],
  "additionalProperties": {},
  "title": "Exam practice template configuration"
}
